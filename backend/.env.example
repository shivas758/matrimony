# Copy to .env and fill in. NEVER commit .env
DB_NAME=matrimony
DB_USER=matrimony
DB_PASSWORD=put-a-strong-password-here
# Generate with: openssl rand -hex 32
JWT_SECRET=put-a-long-random-secret-here
# On the Oracle VM set this to your https domain, e.g. https://profiles.yourdomain.in
PUBLIC_BASE_URL=http://localhost:3000

# Optional — enables "Fill from bio-data" (AI import). Get a key at console.anthropic.com.
# Leave blank to disable the feature; everything else works without it.
ANTHROPIC_API_KEY=
# Extraction model. claude-opus-5 (default) is most accurate; claude-haiku-4-5 is ~5x cheaper.
CLAUDE_MODEL=claude-opus-5

# ---- OTP for signups / customer login (SPEC §9.1, §9.19) ----
# mock     = nothing is sent; every number accepts OTP_MOCK_CODE and the apps show it as a hint.
# startmessaging = real SMS through StartMessaging (https://startmessaging.com) — the one in use:
#            no DLT of our own, ₹0.25/SMS. Set the STARTMESSAGING_* values below.
# fast2sms = real SMS through Fast2SMS's OTP route (https://www.fast2sms.com) — set FAST2SMS_API_KEY.
#            The account needs KYC and a first recharge of at least ₹100. Works with every app
#            version. Steps: deploy/ORACLE_SETUP.md "Fast2SMS".
# firebase = Firebase phone auth: the phone sends/reads the SMS through Firebase and the server
#            checks the Firebase ID token. Needs the FIREBASE_* values below (OTP does not need
#            the service account) and the 3.1.0 apps — older apps are told to update.
#            Steps: deploy/ORACLE_SETUP.md "Firebase phone OTP".
# msg91    = real SMS through MSG91 (https://msg91.com) — set the three MSG91_* values below.
OTP_PROVIDER=mock
OTP_MOCK_CODE=123456
# Show the mock code in API responses so testers see it in the app (mock provider only).
OTP_MOCK_ECHO=true
# Reviewer login (SPEC §9.19 F): this one customer number gets this fixed 6-digit code and
# never an SMS — give both to Razorpay / store reviewers. Leave empty when not needed.
OTP_REVIEW_PHONE=
OTP_REVIEW_CODE=
STARTMESSAGING_API_KEY=
STARTMESSAGING_TEMPLATE_ID=
STARTMESSAGING_APP_NAME=Wedbook
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=

# ---- Public website at the domain root (SPEC §9.19 E) ----
# Shown on the Contact / Terms / Privacy / Refund pages; empty values are left out.
SITE_BUSINESS_NAME=Wedbook
SITE_ADDRESS=
SITE_EMAIL=
SITE_PHONE=

# ---- Wedbook Matrimony registration fee (SPEC §9.12, §9.19 B) ----
# mock     = nothing is charged; the app shows a test checkout (Pay / Simulate failure).
# razorpay = real orders through Razorpay Checkout (Wedbook Matrimony 3.1.0+). Use rzp_test_ keys
#            first, then the rzp_live_ pair. Steps: deploy/ORACLE_SETUP.md "Razorpay".
PAYMENT_PROVIDER=mock
PROFILE_FEE_INR=150
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional but recommended: the secret you type when adding the webhook
# https://<your domain>/api/payments/razorpay/webhook (events order.paid, payment.captured).
RAZORPAY_WEBHOOK_SECRET=

# ---- Firebase project (one project for OTP and push; SPEC §9.16, §9.19 A) ----
# Project settings → General: project id, Web API key, project number (= sender id), and the
# App ID of each Android app (com.matrimonyagents.matrimony_agents = agent,
# com.matrimonyagents.gandharva = customer). These are public client settings.
# (The pre-v2.9 names FCM_PROJECT_ID / FCM_API_KEY / FCM_SENDER_ID / FCM_APP_ID_MEDIATOR /
# FCM_APP_ID_GANDHARVA / FCM_SERVICE_ACCOUNT still work.)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
FIREBASE_APP_ID_AGENT=
FIREBASE_APP_ID_CUSTOMER=
# Push notifications only: the service-account JSON key, base64-encoded on one line
# (base64 -w0 key.json). Leave empty = push off; OTP still works.
FIREBASE_SERVICE_ACCOUNT=
# fcm (default when the project id + service account are set) | log (tests) | off
PUSH_PROVIDER=
