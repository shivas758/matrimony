# Copy to .env and fill in. NEVER commit .env
DB_NAME=matrimony
DB_USER=matrimony
DB_PASSWORD=put-a-strong-password-here
# Generate with: openssl rand -hex 32
JWT_SECRET=put-a-long-random-secret-here
# On the Oracle VM set this to your https domain, e.g. https://profiles.yourdomain.in
PUBLIC_BASE_URL=http://localhost:3000

# Optional — enables "Fill from bio-data" (AI import). Get a key at console.anthropic.com.
# Leave blank to disable the feature; everything else works without it.
ANTHROPIC_API_KEY=
# Extraction model. claude-opus-5 (default) is most accurate; claude-haiku-4-5 is ~5x cheaper.
CLAUDE_MODEL=claude-opus-5

# ---- OTP for signups / customer login (SPEC §9.1) ----
# mock  = nothing is sent; every number accepts OTP_MOCK_CODE and the apps show it as a hint.
# msg91 = real SMS through MSG91 (https://msg91.com) — set the three MSG91_* values below.
OTP_PROVIDER=mock
OTP_MOCK_CODE=123456
# Show the mock code in API responses so testers see it in the app (mock provider only).
OTP_MOCK_ECHO=true
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=

# ---- MILI registration fee (SPEC §9.12) ----
# mock     = nothing is charged; the app shows a test checkout (Pay / Simulate failure).
# razorpay = real orders through Razorpay — set both RAZORPAY_* keys (and ship the app
#            update with the Razorpay Checkout plugin).
PAYMENT_PROVIDER=mock
PROFILE_FEE_INR=150
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Push notifications (SPEC §9.16, Firebase Cloud Messaging) ----
# Leave empty = push off (the apps keep working, no pushes). See deploy/ORACLE_SETUP.md
# "Push notifications" for creating the Firebase project. No app rebuild is needed.
FCM_PROJECT_ID=
FCM_API_KEY=
FCM_SENDER_ID=
FCM_APP_ID_MEDIATOR=
FCM_APP_ID_GANDHARVA=
# The service-account JSON key, base64-encoded on one line: base64 -w0 key.json
FCM_SERVICE_ACCOUNT=
# fcm (default when the keys are set) | log (tests) | off
PUSH_PROVIDER=
