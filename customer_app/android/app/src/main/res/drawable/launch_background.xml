<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash shown until Flutter draws its first frame: the Wedbook
     Matrimony logo tile centred on the cream background (the Flutter splash in
     lib/main.dart draws the same picture). Logo PNGs come from tool/gen_logo.mjs. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background"/>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo"/>
    </item>
</layer-list>
